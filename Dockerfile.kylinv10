#FROM ubuntu:20.04
FROM macrosan/kylin:v10-sp3-2403

ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Asia/Shanghai

RUN yum update -y && \
    yum install -y curl

RUN yum install -y \
    tzdata \
    gcc \
    glib2-devel \
    openssl-devel \
    gtk3-devel \
    webkit2gtk3-devel \
    libappindicator-gtk3-devel \
    librsvg2-devel \
    pkgconfig \
    make

RUN yum install -y \
    musl-gcc \
    musl-tools || true

RUN yum install -y \
    wget \
    ImageMagick \
    file

WORKDIR /root
ENV HOME=/root

# Install Rust with minimal profile and add targets in one layer
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal \
    && . $HOME/.cargo/env \
    && cargo -V \
    && rustup target add x86_64-unknown-linux-musl x86_64-unknown-linux-gnu \
    && rm -rf $HOME/.cargo/registry/cache \
    && rm -rf $HOME/.cargo/git/db

ENV PATH="$HOME/.cargo/bin:${PATH}"

RUN rustup component add rust-src rustc-dev
RUN rustup target add aarch64-unknown-linux-musl

ENV CFLAGS="-O1 -ffunction-sections -fdata-sections"
ENV CXXFLAGS="-O1 -ffunction-sections -fdata-sections"
ENV OPT_LEVEL=1
ENV CARGO_PROFILE_DEV_OPT_LEVEL=1
ENV CARGO_PROFILE_RELEASE_OPT_LEVEL=1
ENV TZ=Asia/Shanghai

# Install Node.js 20 for RHEL/CentOS
RUN curl -fsSL https://rpm.nodesource.com/setup_20.x | bash - && \
    yum install -y nodejs

# 按转OpenCode
RUN npm install -g opencode-ai

# Install cmake from binary
RUN wget https://github.com/Kitware/CMake/releases/download/v3.28.1/cmake-3.28.1-linux-aarch64.sh && \
    chmod +x cmake-3.28.1-linux-aarch64.sh && \
    ./cmake-3.28.1-linux-aarch64.sh --prefix=/usr/local --skip-license && \
    rm -f cmake-3.28.1-linux-aarch64.sh

RUN yum install -y \
    make \
    alsa-lib-devel \
    fontconfig-devel \
    webkit2gtk3-devel \
    openssl-devel \
    gtk3-devel \
    libX11-xcb-devel \
    libxkbcommon-x11-devel

# 清理缓存以减小镜像大小
RUN yum clean all && rm -rf /var/cache/yum/*

# 默认命令
CMD ["/bin/bash"]
